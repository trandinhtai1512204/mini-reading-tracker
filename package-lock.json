{
  "name": "mini-reading-tracker",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mini-reading-tracker",
      "version": "0.1.0",
      "workspaces": [
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@reading-tracker/api",
      "version": "0.1.0",
      "engines": {
        "node": ">=20"
      }
    },
    "apps/web": {
      "name": "@reading-tracker/web",
      "version": "0.1.0",
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@reading-tracker/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@reading-tracker/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}
